# aeternus-taskbar.service — DESABILITADO COMO SERVIÇO SYSTEMD
# O panel e taskbar são iniciados exclusivamente pelo .xinitrc
# Isso evita que tentem conectar ao DISPLAY antes do Xorg estar ativo,
# o que causava múltiplos shells e falhas de inicialização.
#
# Este arquivo existe apenas como referência.
# NÃO habilitar com: systemctl enable aeternus-taskbar
#
# Para iniciar manualmente após X estar ativo:
#   DISPLAY=:0 aeternus-taskbar &

[Unit]
Description=V0rtexOS Desktop Taskbar (NÃO habilitar — iniciado via .xinitrc)
Documentation=file:///usr/local/src/aeternus-gui/panel/aeternus-taskbar.c
# Nenhum [Install] section = não pode ser habilitado acidentalmente
