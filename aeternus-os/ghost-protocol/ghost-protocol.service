[Unit]
Description=V0RTEX Ghost Protocol — VPN+Tor Kill Switch
Documentation=man:iptables(8) man:tor(1)

# Ordenação (não dependência): garante que, se tor/openvpn estiverem ativos,
# este serviço sobe DEPOIS — mas não falha se eles não subirem.
After=network-online.target
After=tor.service
After=openvpn.service

# Wants = dependência soft: solicita a subida dos serviços, mas NÃO bloqueia
# este serviço caso eles falhem. NUNCA use Requires= aqui — causaria falha
# em cascata com o kill switch ativo (rede bloqueada e serviço morto).
Wants=network-online.target
Wants=tor.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Variáveis de ambiente
Environment="TUN_IFACE=tun0"

# Executar o script de configuração
ExecStart=/usr/local/bin/ghost-protocol.sh start
ExecStop=/usr/local/bin/ghost-protocol.sh stop
ExecReload=/usr/local/bin/ghost-protocol.sh stop && /usr/local/bin/ghost-protocol.sh start

# Hardening do processo systemd
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run /tmp /var/log
PrivateTmp=no
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes

# Oneshot não suporta Restart=on-failure com RemainAfterExit=yes de forma útil
# Restart removido para evitar loop de falhas no journal

[Install]
WantedBy=multi-user.target
